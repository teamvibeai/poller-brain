{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Write .claude/**",
      "Edit",
      "Edit .claude/**",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__slack__*",
      "mcp__teamvibe-api__*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx $CLAUDE_CONFIG_DIR/hooks/bash-telemetry.ts"
          }
        ]
      }
    ]
  }
}
