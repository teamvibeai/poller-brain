{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Write .claude/**",
      "Edit",
      "Edit .claude/**",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__slack__*",
      "mcp__teamvibe-api__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/block-background-escapes.sh"
          }
        ]
      },
      {
        "matcher": "mcp__slack__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/block-double-asterisk-bold.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/block-stop-with-pending-subagents.sh"
          }
        ]
      }
    ]
  }
}
