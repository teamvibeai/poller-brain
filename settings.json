{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Write .claude/**",
      "Edit",
      "Edit .claude/**",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__slack__*",
      "mcp__teamvibe-api__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_CONFIG_DIR/scripts/ensure-gh-cli.mjs",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
